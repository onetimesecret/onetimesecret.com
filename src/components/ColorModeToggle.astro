---
// src/components/ColorModeToggle.astro
// https://astro.build/themes/details/accessible-astro-starter/
// https://accessible-astro.incluud.dev/getting-started/introduction/
import enTranslations from "@/i18n/ui/en.json";
import OIcon from "@/components/vue/icons/OIcon.vue";

// For now, we only use English translations at build time
const translations = enTranslations;
---

<div class="flex flex-col items-end">
  <button
    id="theme-cycler-button"
    type="button"
    class="focus-visible:outline-brand-500 dark:focus-visible:outline-brand-400 inline-flex items-center rounded-md px-2 py-1 text-sm font-medium text-gray-600 transition-colors hover:bg-gray-200 hover:text-gray-900 focus-visible:outline-2 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-100"
    aria-label={translations.web.theme?.toggleTheme ||
      "Toggle theme"}
    data-tooltip-id="theme-tooltip">
    <OIcon
      collection="heroicons"
      name="swatch"
      size="5"
    />
    <span class="ml-1.5 hidden sm:inline">
      {translations.web.theme?.toggleTheme || "Toggle theme"}
    </span>
  </button>
</div>

<script>
  import ThemeManager, {
    AVAILABLE_THEMES,
    type ThemeOption,
  } from "@/utils/theme";

  /**
   * The theme currently on <html>, which is the only reliable "current".
   *
   * getPreferredTheme() answers "what would this visitor get on a fresh load",
   * and when storage is unreachable that is always the OS preference — so cycling
   * from it moved one step and then returned the same answer forever, leaving the
   * toggle apparently dead after a single click. Covered by
   * test/e2e/specs/storage-unavailable.spec.ts.
   */
  function appliedTheme(): ThemeOption {
    const classes = document.documentElement.classList;
    return (
      AVAILABLE_THEMES.find((theme) => classes.contains(theme)) ??
      ThemeManager.getPreferredTheme()
    );
  }

  /**
   * Cycles to the next theme in the available themes and applies it
   */
  function cycleTheme() {
    const currentTheme = appliedTheme();
    const currentIndex = AVAILABLE_THEMES.indexOf(currentTheme);
    const nextIndex = (currentIndex + 1) % AVAILABLE_THEMES.length;
    const nextTheme = AVAILABLE_THEMES[nextIndex];

    ThemeManager.setTheme(nextTheme);
    updateTooltip(nextTheme);
  }

  /**
   * Updates the tooltip text with current theme information.
   *
   * Inert today: the button carries data-tooltip-id="theme-tooltip" but nothing
   * in the codebase renders an element with that id, so getElementById() is
   * always null and every branch guarded by `tooltip` is unreachable. Left in
   * place and kept correct rather than deleted, so that adding the element is
   * not also the moment a stale-theme bug appears.
   */
  function updateTooltip(theme: ThemeOption) {
    const tooltip = document.getElementById("theme-tooltip");
    if (tooltip) {
      const themeName = theme.charAt(0).toUpperCase() + theme.slice(1);
      tooltip.textContent = `Current: ${themeName}`;
    }
  }

  /**
   * Initializes theme management
   */
  function initializeThemeSystem() {
    // Initialize theme manager
    ThemeManager.initialize();

    // Set up event listener for the theme toggle button
    const cycleButton = document.getElementById("theme-cycler-button");
    const tooltip = document.getElementById("theme-tooltip");

    if (cycleButton) {
      cycleButton.addEventListener("click", cycleTheme);

      // Setup tooltip behavior. appliedTheme(), not getPreferredTheme(): the
      // tooltip reports what is on the page, and with storage unreachable the
      // preference is the OS answer, so after a click to dark it would have read
      // "Current: Light". Same defect as the one cycleTheme carried.
      cycleButton.addEventListener("mouseenter", () => {
        if (tooltip) {
          updateTooltip(appliedTheme());
          tooltip.classList.remove("hidden");
        }
      });

      cycleButton.addEventListener("mouseleave", () => {
        if (tooltip) tooltip.classList.add("hidden");
      });

      // For accessibility - handle focus events
      cycleButton.addEventListener("focus", () => {
        if (tooltip) {
          updateTooltip(appliedTheme());
          tooltip.classList.remove("hidden");
        }
      });

      cycleButton.addEventListener("blur", () => {
        if (tooltip) tooltip.classList.add("hidden");
      });
    }
  }

  // Run initialization when document is ready
  if (typeof window !== "undefined") {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initializeThemeSystem);
    } else {
      initializeThemeSystem();
    }
  }
</script>
