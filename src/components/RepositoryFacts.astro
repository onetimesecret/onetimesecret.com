---
import type { SupportedLanguage } from "@config/astro/i18n";

import en from "@/i18n/ui/en.json";
import { getLocaleFromUrl } from "@/i18n/utils";
import { renderScopedId } from "@/utils/elementId";
import {
  fetchRepositoryLanguages,
  normalizeLanguages,
  resolveRepository,
  type RepositoryOptions,
} from "@/utils/repository";
import {
  fetchRepositoryCommits,
  normalizeRepositoryCommits,
  type RepositoryCommits,
} from "@/utils/repository-commits";

export interface Props extends RepositoryOptions {
  label?: string;
  lang?: SupportedLanguage;
  class?: string;
  style?: "text" | "bar" | "card";
  /** Optional pinned API response: bytes for GitHub/Forgejo/Gitea, percentages for GitLab. */
  languages?: Record<string, number>;
  /** Pin commit facts for offline builds, or hide them with false. */
  commits?: RepositoryCommits | false;
  /** Build-only environment variable name; never pass a token literal through MDX. */
  tokenEnv?: string;
}

const {
  label,
  lang = getLocaleFromUrl(Astro.url),
  languages,
  commits,
  tokenEnv,
  style: displayStyle = "text",
} = Astro.props;
const repository = resolveRepository(Astro.props);
// Reserve the id before any await so render order, not fetch timing, decides it.
const candidateDisclosureId = renderScopedId(
  Astro.locals,
  "repository-languages",
);
const messages =
  lang === "en" ? en : (await import(`../i18n/ui/${lang}.json`)).default;
// A lagging locale falls back to English labels instead of failing the build.
const text: (typeof en)["repository-facts"] = {
  ...en["repository-facts"],
  ...messages["repository-facts"],
};
const percent = new Intl.NumberFormat(lang, {
  style: "percent",
  maximumSignificantDigits: 3,
});
// process.env: in builds, import.meta.env only resolves keys named literally in this
// file (tokenEnv is a runtime value) and inlines their values into the server bundle.
const token = tokenEnv ? process.env[tokenEnv] : undefined;
async function load<T>(
  name: string,
  fetcher: () => Promise<T>,
): Promise<T | undefined> {
  try {
    if (tokenEnv && !token) throw new Error("Missing repository API token.");
    return await fetcher();
  } catch (error) {
    // Keep API errors and credentials out of generated HTML and build logs; log only
    // the error name (TimeoutError, SyntaxError, TypeError) as a debugging hint.
    const kind = error instanceof Error ? error.name : typeof error;
    const message = `${name} unavailable for ${repository.url} (${kind})`;
    // Surface the degraded page as a workflow annotation in GitHub Actions builds.
    const prefix =
      process.env.GITHUB_ACTIONS === "true"
        ? "::warning title=RepositoryFacts::"
        : "[RepositoryFacts] ";
    console.warn(`${prefix}${message}`);
    return undefined;
  }
}
const [breakdown, commitFacts] = await Promise.all([
  languages !== undefined
    ? normalizeLanguages(languages, repository.unit)
    : load("Language statistics", () =>
        fetchRepositoryLanguages(repository, token),
      ),
  commits === false
    ? undefined
    : commits !== undefined
      ? normalizeRepositoryCommits(commits)
      : load("Commit statistics", () =>
          fetchRepositoryCommits(repository, token),
        ),
]);
const formattedCount =
  commitFacts?.count != null
    ? new Intl.NumberFormat(lang).format(commitFacts.count)
    : text["unavailable-value"];
const latestCommitAt = commitFacts?.latestCommitAt;
const formattedDate = latestCommitAt
  ? new Intl.DateTimeFormat(lang, {
      dateStyle: "medium",
      timeZone: "UTC",
    }).format(new Date(latestCommitAt))
  : commitFacts?.count === 0
    ? text["no-commits"]
    : text["unavailable-value"];

// Colors identify languages consistently across repositories and display styles.
const hues = new Map([
  ["Ruby", 355],
  ["TypeScript", 210],
  ["Vue", 153],
  ["Shell", 95],
  ["Python", 45],
  ["JavaScript", 55],
  ["HTML", 16],
  ["Dockerfile", 195],
  ["CSS", 275],
  ["PLpgSQL", 225],
  ["HCL", 255],
  ["Go", 185],
  ["Rust", 25],
]);
const rows = breakdown?.languages.map(({ language, share }) => {
  const hash = Array.from(language).reduce(
    (value, char) => (value * 31 + char.codePointAt(0)!) >>> 0,
    0,
  );
  return {
    language,
    share,
    formatted: percent.format(share / 100),
    color: `hsl(${hues.get(language) ?? hash % 360} 65% 55%)`,
  };
});
// Collapse shares below 1% only when something remains visible above the cutoff.
const collapsible = rows?.some(({ share }) => share >= 1) ?? false;
const isSecondary = (share: number) => collapsible && share < 1;
const primaryRows = rows?.filter(({ share }) => !isSecondary(share)) ?? [];
const secondaryRows = rows?.filter(({ share }) => isSecondary(share)) ?? [];
const disclosureId = secondaryRows.length ? candidateDisclosureId : undefined;
const summarize = (group: typeof primaryRows) =>
  group.map(({ language, formatted }) => `${language} ${formatted}`).join(", ");
const rowGroups = secondaryRows.length
  ? [primaryRows, secondaryRows]
  : [primaryRows];
const status = breakdown ? text.empty : text.unavailable;
---

{displayStyle === "text" ? (
  <span
    class:list={["repository-facts not-prose text-sm", Astro.props.class]}
    data-repository-facts
    data-style="text"
    data-language-unit={breakdown?.unit}>
    <a
      href={repository.url}
      class="repository-link"
      set:text={label ?? repository.name}
    />
    {" ("}
    <span class="text-text-secondary">
      {rows?.length ? (
        <Fragment>
          <span
            class="sr-only"
            set:text={`${text.languages}: `}
          />
          <repository-language-disclosure>
            <span set:text={summarize(primaryRows)} />
            {secondaryRows.length > 0 && (
              <Fragment>
                <span
                  id={disclosureId}
                  data-language-secondary>
                  {primaryRows.length > 0 && ", "}
                  <span set:text={summarize(secondaryRows)} />
                </span>
                <button
                  type="button"
                  class="language-toggle"
                  data-language-toggle
                  data-show-more={text["show-more"]}
                  data-show-less={text["show-less"]}
                  aria-expanded="false"
                  aria-controls={disclosureId}
                  hidden
                  set:text={text["show-more"]}
                />
              </Fragment>
            )}
          </repository-language-disclosure>
        </Fragment>
      ) : (
        status
      )}
    </span>
    {")"}
    {commits !== false && (
      <span
        class="repository-inline-activity"
        data-commit-facts>
        {" · "}
        <span
          class="sr-only"
          set:text={`${text["default-branch"]}: `}
        />
        {text.commits}: {formattedCount}
        {" · "}
        {text["latest-commit"]}:{" "}
        {latestCommitAt ? (
          <time
            datetime={latestCommitAt}
            set:text={formattedDate}
          />
        ) : (
          formattedDate
        )}
      </span>
    )}
  </span>
) : (
  <figure
    class:list={[
      "repository-facts repository-visual not-prose",
      `repository-${displayStyle}`,
      Astro.props.class,
    ]}
    data-repository-facts
    data-style={displayStyle}
    data-language-unit={breakdown?.unit}>
    <figcaption class="repository-heading">
      <a
        href={repository.url}
        class="repository-link"
        set:text={label ?? repository.name}
      />
      <span
        class="repository-host"
        set:text={new URL(repository.url).host}
      />
    </figcaption>
    {commits !== false && (
      <dl
        class="repository-activity"
        aria-label={text["default-branch"]}
        data-commit-facts>
        <div>
          <dt set:text={text.commits} />
          <dd
            data-commit-count
            set:text={formattedCount}
          />
        </div>
        <div>
          <dt set:text={text["latest-commit"]} />
          <dd>
            {latestCommitAt ? (
              <time
                datetime={latestCommitAt}
                set:text={formattedDate}
              />
            ) : (
              formattedDate
            )}
          </dd>
        </div>
      </dl>
    )}
    {rows?.length ? (
      <Fragment>
        <p
          class="repository-label"
          set:text={text.languages}
        />
        <repository-language-disclosure class="language-disclosure-visual">
          {displayStyle === "bar" && (
            <span
              class="language-strip"
              aria-hidden="true"
              data-language-chart>
              {rows.map(({ language, share, color }) => (
                <span
                  data-language={language}
                  data-language-secondary={isSecondary(share) ? "" : undefined}
                  style={`width: ${share}%; background-color: ${color}`}
                />
              ))}
            </span>
          )}
          {rowGroups.map((group, index) => (
            <Fragment>
              {index === 1 && (
                <button
                  type="button"
                  class="language-toggle"
                  data-language-toggle
                  data-show-more={text["show-more"]}
                  data-show-less={text["show-less"]}
                  aria-expanded="false"
                  aria-controls={disclosureId}
                  hidden
                  set:text={text["show-more"]}
                />
              )}
              {group.length > 0 && (
                <ul
                  class="language-list"
                  role="list"
                  id={index === 1 ? disclosureId : undefined}
                  data-language-secondary={index === 1 ? "" : undefined}>
                  {group.map(({ language, share, formatted, color }) => (
                    <li
                      class="language-item"
                      style={`--language-color: ${color}`}>
                      <span class="language-name">
                        <span
                          class="language-swatch"
                          aria-hidden="true"
                        />
                        <span set:text={language} />
                      </span>
                      <span
                        class="language-share"
                        set:text={formatted}
                      />
                      {displayStyle === "card" && (
                        <span
                          class="language-track"
                          aria-hidden="true"
                          data-language-chart>
                          <span style={`width: ${share}%`} />
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </Fragment>
          ))}
        </repository-language-disclosure>
      </Fragment>
    ) : (
      <p
        class="repository-status"
        set:text={status}
      />
    )}
  </figure>
)}

<script>
  import { attachLanguageDisclosure } from "@/scripts/repository-language-disclosure";

  class RepositoryLanguageDisclosure extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      this.cleanup?.();
      this.cleanup = attachLanguageDisclosure(this);
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get("repository-language-disclosure")) {
    customElements.define(
      "repository-language-disclosure",
      RepositoryLanguageDisclosure,
    );
  }
</script>

<style>
  .repository-facts [hidden] {
    display: none !important;
  }

  .language-disclosure-visual {
    display: block;
  }

  .language-toggle {
    margin-inline-start: 0.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .language-toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
    border-radius: 0.125rem;
  }

  .language-disclosure-visual > .language-toggle {
    margin-top: 0.875rem;
    margin-inline-start: 0;
    color: var(--color-text-secondary);
  }

  .repository-link {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .repository-link:hover {
    text-decoration-color: currentColor;
  }

  .repository-visual {
    margin: 1.5rem 0;
    color: var(--color-text-primary);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .repository-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .repository-host,
  .repository-label,
  .repository-status,
  .language-share {
    color: var(--color-text-secondary);
  }

  .repository-host {
    font-size: 0.75rem;
  }

  .repository-label {
    margin: 0.75rem 0 0.5rem;
    font-size: 0.75rem;
  }

  .language-strip,
  .language-track {
    display: flex;
    overflow: hidden;
    background: var(--color-surface-3);
    border-radius: 999px;
  }

  .language-strip {
    height: 0.625rem;
  }

  .language-strip > span {
    flex-shrink: 0;
  }

  .language-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .language-item,
  .language-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .language-name > span:last-child {
    overflow-wrap: anywhere;
  }

  .language-swatch {
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--language-color);
  }

  .language-share {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .repository-card {
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid var(--color-surface-3);
    border-radius: 0.875rem;
    background: var(--color-surface-1);
  }

  .repository-card .language-list {
    display: grid;
    gap: 0.875rem;
  }

  .repository-card .language-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.25rem 0.75rem;
  }

  .language-track {
    grid-column: 1 / -1;
    height: 0.25rem;
  }

  .language-track > span {
    background: var(--language-color);
    border-radius: inherit;
  }

  .repository-status {
    margin: 0.75rem 0 0;
  }

  .repository-inline-activity,
  .repository-activity dt {
    color: var(--color-text-secondary);
  }

  .repository-activity {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin: 1rem 0;
    font-variant-numeric: tabular-nums;
  }

  .repository-activity > div {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
  }

  .repository-activity dd {
    margin: 0;
    font-weight: 600;
  }

  .repository-card .repository-activity {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-surface-3);
  }
</style>
