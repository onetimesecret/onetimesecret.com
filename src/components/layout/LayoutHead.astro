---
import Favicons from "./Favicons.astro";
import SeoMeta from "./SeoMeta.astro";
import OptimizedFonts from "./OptimizedFonts.astro";

// Utilities
import { generateCspConnectSrc } from "@/utils/security";
import { generateCanonicalUrl } from "@/utils/canonical-url";
import { AVAILABLE_THEMES } from "@/utils/theme";
import {
  getRouteSeoConfig,
  generateBreadcrumbsLd,
  defaultSeoValues,
  getDefaultWebApplicationLd,
} from "@/utils/seo";
import {
  hasLocalizedVariants,
  isLocalePrefixed,
  stripLocalePrefix,
} from "@/i18n/utils";
import { DEFAULT_LANGUAGE, SUPPORTED_LANGUAGES } from "@config/astro/i18n";

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  twitterCard?: string;
  keywords?: string;
  noindex?: boolean;
  alternateLanguages?: { code: string; url: string }[];
  structuredData?: object;
  effectiveLocale: string;
  langDir: string;
}

const {
  title: propsTitle,
  description: propsDescription,
  ogImage: propsOgImage,
  ogType: propsOgType,
  keywords: propsKeywords,
  canonicalUrl: propsCanonicalUrl,
  twitterCard: propsTwitterCard,
  noindex: propsNoindex,
  alternateLanguages: propsAlternateLanguages,
  structuredData: propsStructuredData,
} = Astro.props;

import { CANONICAL_ORIGIN } from '@config/domains';

// Security: collapse consecutive slashes in the path to prevent
// protocol-relative URL injection (CWE-601). A request path like
// //evil.com/attack would otherwise resolve to https://evil.com/attack
// when passed to the URL constructor, creating an open redirect in
// canonical/og:url tags.
const currentPath = Astro.url.pathname.replace(/\/{2,}/g, '/');
const siteOrigin = CANONICAL_ORIGIN;

// SEO Configuration
const routeSpecificSeo = getRouteSeoConfig(currentPath, siteOrigin);

const pageTitle =
  propsTitle || routeSpecificSeo.title || defaultSeoValues.title;
const pageDescription =
  propsDescription ||
  routeSpecificSeo.description ||
  defaultSeoValues.description;
const pageOgImage =
  propsOgImage || routeSpecificSeo.ogImage || defaultSeoValues.ogImage;
const pageOgType =
  propsOgType || routeSpecificSeo.ogType || defaultSeoValues.ogType;
const pageKeywords = propsKeywords || defaultSeoValues.keywords;
const pageCanonicalUrl = propsCanonicalUrl ||
  generateCanonicalUrl(currentPath, Astro.url.search, CANONICAL_ORIGIN);
const pageTwitterCard = propsTwitterCard || defaultSeoValues.twitterCard;

const pageNoindex =
  propsNoindex !== undefined
    ? propsNoindex
    : currentPath.startsWith("/secret/") ||
      currentPath.startsWith("/private/") ||
      currentPath.startsWith("/receipt/");

// Generate alternate language links.
//
// The locale-prefix strip lives in stripLocalePrefix() so it is unit-testable
// rather than only reachable through a built page. The hand-rolled version here
// got it wrong twice: its prefix list omitted "es", so no Spanish path counted as
// prefixed and every /es/ page emitted doubled hrefs that 404 (/en/es/about/,
// /es/es/about/) across a quarter of the localized site; and its `startsWith`
// test had no segment boundary, so "/env-debug/" matched "/en" and the fixed
// three-character strip turned it into "/frv-debug/" and x-default
// "https://onetimesecret.comv-debug/". Gated by
// test/e2e/specs/canonical-url.spec.ts and test/unit/i18n/locale-paths.test.ts.
const basePathForAlternates = stripLocalePrefix(currentPath);

// Only annotate a page that actually has localized counterparts. Emitting one
// alternate per language unconditionally assumed every page had a twin at
// /{lang}{path}, which advertised twenty URLs that 404: four each on /privacy/,
// /terms/, /example/, /env-debug/ and /test-layout/, none of which exist under a
// locale prefix. Google discards a cluster whose targets do not resolve, so those
// pages got no locale signal and the dead URLs were crawled from the footer links
// on every page. hasLocalizedVariants() reads the site's structure instead of a
// list: see its docstring in src/i18n/utils.ts. Issue #211.
//
// `??` rather than `||`: a page that passes an empty array is saying it has no
// alternates, and that has to survive rather than fall through to the default.
const pageAlternateLanguages =
  propsAlternateLanguages ??
  (hasLocalizedVariants(currentPath)
    ? SUPPORTED_LANGUAGES.map((lang) => ({
        code: lang,
        url: `${siteOrigin}/${lang}${basePathForAlternates}`,
      }))
    : []);

// x-default names the version served to a visitor whose language none of the
// alternates match, so it has to be a URL that exists.
//
// For a locale-prefixed page that is the default-locale sibling, which is
// guaranteed to exist because the page itself is one of the cluster. Naming the
// unprefixed path instead only worked where a top-level redirect happened to
// cover it (/about, /pricing, /security in config/astro/redirects.ts): the 21
// changelog entries and the use-cases index have no such entry, so 84 pages
// advertised an x-default that 404s. Per-entry redirects would need a new one
// with every changelog post; pointing at the default locale needs nothing, and
// Google allows x-default to coincide with a language version.
//
// For a page with no locale prefix, x-default is the page itself: /privacy/ is
// the version for every language, and unlike /en/privacy/ it exists.
const xDefaultUrl = isLocalePrefixed(currentPath)
  ? `${siteOrigin}/${DEFAULT_LANGUAGE}${basePathForAlternates}`
  : `${siteOrigin}${currentPath}`;

const pageStructuredData =
  propsStructuredData ||
  routeSpecificSeo.structuredData ||
  getDefaultWebApplicationLd(siteOrigin, pageDescription);

const pageBreadcrumbsLd = generateBreadcrumbsLd(currentPath, siteOrigin);

// Site-wide Organization + WebSite JSON-LD (complements per-route structured data)
const siteJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: "Onetime Secret",
      url: siteOrigin,
      logo: `${siteOrigin}/etc/img/onetime-logo-md.png`,
    },
    {
      "@type": "WebSite",
      name: "Onetime Secret",
      url: siteOrigin,
    },
  ],
};

// Content Security Policy
const apiUrl = import.meta.env.VITE_PUBLIC_API_BASE_URL;
const isDebugMode = import.meta.env.DEV || import.meta.env.DEBUG;
const connectSrcDirective = generateCspConnectSrc(apiUrl, isDebugMode);
---

<head>
  <meta charset="utf-8" />
  <meta
    http-equiv="Content-Type"
    content="text/html; charset=utf-8"
  />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />
  <meta
    name="color-scheme"
    content="dark light contrast"
  />
  <meta
    name="author"
    content="Onetime Secret"
  />
  <Favicons />
  <SeoMeta
    title={pageTitle}
    description={pageDescription}
    canonicalUrl={pageCanonicalUrl}
    ogImageBaseUrl={siteOrigin}
    ogImage={pageOgImage}
    ogType={pageOgType}
    twitterCard={pageTwitterCard}
    keywords={pageKeywords}
    noindex={pageNoindex}
    alternateLanguages={pageAlternateLanguages}
    structuredData={pageStructuredData}
    breadcrumbsLd={pageBreadcrumbsLd}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(siteJsonLd)}
  />
  <link
    rel="sitemap"
    href="/sitemap-index.xml"
  />
  {/* x-default stays on every page, with or without per-locale alternates. */}
  <link
    rel="alternate"
    hreflang="x-default"
    href={xDefaultUrl}
  />
  <OptimizedFonts />
  <meta
    http-equiv="Content-Security-Policy"
    content={`default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src ${connectSrcDirective}; worker-src 'self' blob:;`}
  />
  <script is:inline define:vars={{ AVAILABLE_THEMES }}>
    // Minimal inline script to prevent FOUC - matches ThemeManager utility
    // implementation. AVAILABLE_THEMES comes from utils/theme.ts via define:vars,
    // so the list cannot drift; the resolution order below still has to match
    // ThemeManager.getPreferredTheme() by hand.

    // Honor system preference — must match ThemeManager.getPreferredTheme() to
    // avoid a dark→light flip on hydration (which causes CLS). Read outside the
    // try: a browser that denies site data throws from the `localStorage`
    // property itself, and with this read inside the try that threw before the
    // preference was consulted, so the page painted dark and then flipped to
    // light once ThemeManager resolved the same preference after hydration.
    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    let themeToApply = prefersDark ? "dark" : "light";

    try {
      const storedTheme = localStorage.getItem("theme");
      if (storedTheme && AVAILABLE_THEMES.includes(storedTheme)) {
        themeToApply = storedTheme;
      }
    } catch (e) {
      // localStorage might be unavailable; the system preference above stands
    }

    // Apply theme classes
    AVAILABLE_THEMES.forEach((t) =>
      document.documentElement.classList.remove(t),
    );
    // This is also what drives Tailwind's `dark:` utilities, which tailwind.css
    // declares as a class variant: `@custom-variant dark (&:where(.dark, .dark
    // *))`. "dark" is in AVAILABLE_THEMES, so the loop above already cleared it
    // and this covers re-adding it — the separate `if (themeToApply === "dark")`
    // branch that used to sit here was a no-op in both directions. Kept in step
    // with ThemeManager.applyTheme(), which says the same thing.
    document.documentElement.classList.add(themeToApply);
  </script>
  <title>{pageTitle}</title>
</head>
