---
export interface Props {
  id: string;
  class?: string;
}

const { id, class: className } = Astro.props;

if (!/^CVE-\d{4}-\d{4,}$/.test(id)) {
  throw new Error(
    `Invalid CVE ID: ${id}. Expected CVE-YYYY-NNNN (four or more digits).`,
  );
}

const href = `https://www.cve.org/CVERecord?id=${id}`;
---

<a
  href={href}
  rel="nofollow"
  class:list={[
    "not-prose inline-block rounded-md border px-1.5 py-0.5 align-baseline",
    "font-mono text-[0.85em] leading-normal font-medium whitespace-nowrap no-underline",
    "border-brandcomp-200 bg-brandcomp-50 text-brandcomp-800",
    "hover:border-brandcomp-300 hover:bg-brandcomp-100",
    "dark:border-brandcomp-800 dark:bg-brandcomp-950/50 dark:text-brandcomp-300",
    "dark:hover:border-brandcomp-700 dark:hover:bg-brandcomp-900/50",
    "transition-colors focus-visible:outline-2 focus-visible:outline-offset-2",
    "focus-visible:outline-brandcomp-600 dark:focus-visible:outline-brandcomp-400",
    className,
  ]}
  set:text={id}
/>
