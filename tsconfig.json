// https://docs.astro.build/en/guides/imports/#aliases
{
  "extends": "astro/tsconfigs/strict",
  // `test/unit/**` only: `test/e2e` is type-checked separately via
  // test/e2e/tsconfig.json (see the `type-check:e2e` script), which targets
  // Playwright's Node-based test runner rather than this config's DOM/Vue setup.
  "include": [".astro/types.d.ts", "config/**/*", "src/**/*", "test/unit/**/*"],
  "exclude": ["dist", "tmp"],
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "preserve",
    "verbatimModuleSyntax": false,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"],
      "@root/*": ["./*"],
      "@config/*": ["./config/*"],
      "@tests/*": ["./test/*"]
    }
  }
}
