// https://docs.astro.build/en/guides/imports/#aliases
{
  "extends": "astro/tsconfigs/strict",
  // `test/unit/**` only: `test/e2e` ships its own ambient shim for
  // @playwright/test that collides with the real package's types here, and it
  // is already covered by test/e2e/tsconfig.json.
  "include": [".astro/types.d.ts", "config/**/*", "src/**/*", "test/unit/**/*"],
  "exclude": ["dist", "tmp"],
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "preserve",
    "verbatimModuleSyntax": false,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"],
      "@root/*": ["./*"],
      "@config/*": ["./config/*"],
      "@tests/*": ["./test/*"]
    }
  }
}
