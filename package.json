{
  "version": "3.3.1",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "build:verify": "node scripts/verify-dist.mjs",
    "build:verify:live": "node scripts/verify-live.mjs",
    "build:verify:hreflang": "node scripts/verify-hreflang.mjs",
    "check": "astro check --tsconfig tsconfig.json",
    "clean": "rm -rf dist/ .astro/ node_modules/.vite/",
    "reinstall": "pnpm clean && pnpm install",
    "dev": "NODE_OPTIONS='--max-old-space-size=8192 --trace-warnings' astro dev --host",
    "edge:build": "rm -rf edge/dist && vite build --config edge/vite.config.ts --mode auth-redirect && vite build --config edge/vite.config.ts --mode country-injection && pnpm edge:verify",
    "edge:verify": "node edge/verify-bundles.mjs",
    "edge:error-page:push": "node edge/error-page/cli.mjs push",
    "edge:error-page:verify": "node edge/error-page/cli.mjs verify",
    "edge:error-page:deploy": "node edge/error-page/cli.mjs deploy",
    "edge:error-page:probe": "node edge/error-page/cli.mjs probe",
    "geometry:regions": "node scripts/generate-region-geometry.mjs",
    "lint": "pnpm run lint:base --cache-location ./node_modules/.cache/eslint --cache 'src/**/*.{mjs,ts,d.ts,vue}' 'edge/**/*.{ts,mjs}' 'scripts/**/*.mjs' './*.{mjs,ts,js}'",
    "lint:base": "eslint --quiet --config eslint.config.ts",
    "lint:fix": "pnpm run lint:base --fix 'src/**/*.{mjs,ts,vue}' 'edge/**/*.{ts,mjs}' 'scripts/**/*.mjs' './*.{mjs,ts,d.ts,vue}'",
    "lint:quick": "pnpm run lint:base --cache-location ./node_modules/.cache/eslint --cache 'src/**/*.{mjs,ts}' 'scripts/**/*.mjs' './*.{mjs,ts,js}'",
    "lint:quick:fix": "pnpm run lint:base --fix 'src/**/*.{mjs,ts}' 'scripts/**/*.mjs' './*.{mjs,ts,d.ts,js}'",
    "lint:tests": "pnpm run lint:base 'test/**/*.{mjs,ts,vue}'",
    "preview": "astro preview --host",
    "type-check:base": "vue-tsc --noEmit",
    "type-check:edge": "vue-tsc --noEmit -p tsconfig.edge.json",
    "type-check": "pnpm run type-check:base && pnpm run type-check:edge",
    "type-check:watch": "pnpm run type-check:base --watch",
    "i18n:scan": "vue-i18n-extract --vueFiles \"./src/**/*.?(js|ts|vue|astro|mdx|jsx)\" --languageFiles \"./src/i18n/ui/*.json\"",
    "i18n:add": "vue-i18n-extract --vueFiles \"./src/**/*.?(js|ts|vue|astro|mdx|jsx)\" --languageFiles \"./src/i18n/ui/*.json\" --add",
    "i18n:remove": "vue-i18n-extract --vueFiles \"./src/**/*.?(js|ts|vue|astro|mdx|jsx)\" --languageFiles \"./src/i18n/ui/*.json\" --remove",
    "i18n:markdown": "node src/scripts/generate-markdown-content.mjs",
    "test": "vitest run --config test/unit/vitest.config.ts",
    "test:watch": "vitest --config test/unit/vitest.config.ts",
    "test:e2e": "playwright test --config test/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdoc": "^2.0.9",
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.0.2",
    "@eslint/js": "10.0.1",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@lucide/vue": "^1.41.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vueuse/core": "^14.4.0",
    "astro": "^7.3.1",
    "d3-geo": "^3.1.1",
    "eslint-plugin-vue": "10.11.0",
    "i18next": "^26.4.2",
    "i18next-fs-backend": "^2.6.7",
    "nanostores": "^1.5.3",
    "remark": "^15.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.0",
    "unist-util-visit": "^5.1.0",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.63.0",
    "@sentry/astro": "^10.73.0",
    "@sentry/browser": "^10.73.0",
    "@spotlightjs/astro": "^3.2.6",
    "@spotlightjs/sidecar": "^2.5.0",
    "@spotlightjs/spotlight": "^4.11.8",
    "@types/d3-geo": "^3.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/devtools-kit": "^8.2.1",
    "@vue/test-utils": "^2.5.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "glob": "^13.0.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prettier-plugin-vue": "1.1.6",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n-extract": "^2.0.7",
    "vue-tsc": "^3.3.11",
    "world-atlas": "^2.0.2"
  }
}
