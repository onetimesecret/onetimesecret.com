# .env.example

# dotenv configuration file example
# Copy this file to .env and replace the values with your actual configuration
# Note: This file contains sensitive information, DO NOT commit your actual .env file to version control

# Used to set `site` in Astro config (which sitemap relies on as well)
VITE_BASE_URL=https://example.com

# Activates debug features in dev mode, only is the value is literally "true"
VITE_DEBUG="true"

# Used for homepage secret link UI
# Must be prefixed with VITE_ to be accessible in browser code
VITE_PUBLIC_API_BASE_URL=https://dev.onetime.dev

# Extra hostnames the dev server may be reached on, comma-separated
# (see config/astro/vite.ts). Leave empty unless you proxy the dev server.
VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=

# Sentry configuration
# Server-side Sentry (used during build for source maps)
SENTRY_ORG=exampleorg
SENTRY_AUTH_TOKEN=
SENTRY_PROJECT=
# Server-side DSN (sentry.server.config.ts); Sentry stays off when empty
SENTRY_DSN=

# Client-side Sentry (needs VITE_ prefix for client access)
VITE_SENTRY_DSN=https://your-actual-dsn@sentry.io/project
VITE_SENTRY_ENVIRONMENT=production

# BunnyCDN account API key (dash.bunny.net -> Account -> API)
# Used by `pnpm edge:error-page:push` to push edge/error-page/regional.html to the
# regional pull zones. In CI the same value is the BUNNY_API_KEY secret.
# Read from the environment first, then .env.local, then .env.
BUNNY_API_KEY=

# Pull zone per region for `pnpm edge:error-page:push`, as the zone's name or
# numeric ID (dash.bunny.net -> CDN -> the zone). Only needed for a zone that
# does not carry its public hostname: behind Bunny Shield the hostname ends at
# the shield and the pull zone has a generated name. Zones that do carry the
# hostname are found without this. A `region=zone` argument overrides these.
BUNNY_PULL_ZONE_EU=
BUNNY_PULL_ZONE_CA=
BUNNY_PULL_ZONE_NZ=
BUNNY_PULL_ZONE_US=
BUNNY_PULL_ZONE_UK=
